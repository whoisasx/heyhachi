# Copy to .env and fill in. Never commit .env.

# LLM
ANTHROPIC_API_KEY=

# Cloud browser
BROWSER_USE_API_KEY=

# Database (Neon)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Vault master key (64 hex chars): python -c "import secrets; print(secrets.token_hex(32))"
VAULT_MASTER_KEY=

# App sign-in (Google OAuth, used by the Next.js app via Auth.js)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=

# Shared by the Next.js server (signs) and the backend (verifies) the 15-min backend token
# python -c "import secrets; print(secrets.token_hex(32))"
BACKEND_JWT_SECRET=

# URLs
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
