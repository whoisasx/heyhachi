# Copy to .env and fill in. Never commit .env.

# LLM
ANTHROPIC_API_KEY=
# Optional: LLM_MODEL=claude-sonnet-5-5 (default). EXECUTOR=fake runs tasks without Claude (offline dev).

# Browser. Dev default BROWSER_BACKEND=local (needs Google Chrome installed); BROWSER_HEADLESS=true hides the window.
# Production: Browser Use Cloud key.
BROWSER_USE_API_KEY=
# local (Chrome on this machine) or cloud (Browser Use Cloud, production)
BROWSER_BACKEND=local
# Cloud browser proxy per site ("site:country,..."; subdomains match).
BROWSER_PROXY_SITES=swiggy.com:in
# Proxy country for every other site (empty = no proxy)
BROWSER_PROXY_COUNTRY=

# Database (Neon)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Vault master key (64 hex chars): python -c "import secrets; print(secrets.token_hex(32))"
# 32 random bytes, base64: python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
VAULT_MASTER_KEY=

# App sign-in (Google OAuth, used by the Next.js app via Auth.js)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=

# Shared by the Next.js server (signs) and the backend (verifies) the 15-min backend token
# python -c "import secrets; print(secrets.token_hex(32))"
BACKEND_JWT_SECRET=

# URLs
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Phone verification (Firebase Phone Auth). Leave empty to switch the feature off.
# Backend: the Firebase project id, used to check the proof the browser sends.
FIREBASE_PROJECT_ID=
# Frontend (frontend/.env.local and Vercel): the Firebase web app config. Public values, not secrets.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Local only: skip reCAPTCHA for Firebase test numbers (never set in production)
NEXT_PUBLIC_FIREBASE_TEST_PHONES=
